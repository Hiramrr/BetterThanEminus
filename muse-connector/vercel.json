{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "npm ci",
  "outputDirectory": ".",
  "functions": {
    "api/handler.mjs": {
      "maxDuration": 60,
      "includeFiles": "docs/**"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/handler?__path=$1"
    }
  ]
}
